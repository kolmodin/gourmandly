rules_version = '2';

// Everything in a kitchen is open to its members and closed to everyone else.
// Membership itself (memberIds, ownerId, users/*.kitchenIds) is only ever
// changed by Cloud Functions, which bypass these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(kitchenId) {
      return signedIn() && request.auth.uid in
        get(/databases/$(database)/documents/kitchens/$(kitchenId)).data.memberIds;
    }

    // Readable before signing in: it can tell an old client to update.
    match /meta/app {
      allow read: if true;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /kitchens/{kitchenId} {
      allow read: if isMember(kitchenId);
      allow update: if isMember(kitchenId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'language']);

      match /recipes/{id} {
        allow read, write: if isMember(kitchenId);
      }
      match /tags/{id} {
        allow read, write: if isMember(kitchenId);
      }
      match /staples/{id} {
        allow read, write: if isMember(kitchenId);
      }
      match /plannedRecipes/{id} {
        allow read, write: if isMember(kitchenId);
      }
      match /listItems/{id} {
        allow read, write: if isMember(kitchenId);
      }
      match /checks/{id} {
        allow read, write: if isMember(kitchenId);
      }
      match /overrides/{id} {
        allow read, write: if isMember(kitchenId);
      }

      // Creating a job spends AI budget through the import Function, which
      // alone reports back on the job.
      match /importJobs/{id} {
        allow read: if isMember(kitchenId);
        allow create: if isMember(kitchenId)
          && request.resource.data.keys().hasOnly(['url', 'status', 'createdBy', 'createdAt'])
          && request.resource.data.url is string
          && request.resource.data.status == 'pending'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
      }

      match /usage/{month} {
        allow read: if isMember(kitchenId);
      }
    }
  }
}
