rules_version = '2';

// Recipe photos are readable by the members of their kitchen. Only Cloud
// Functions write them.
service firebase.storage {
  match /b/{bucket}/o {
    match /kitchens/{kitchenId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid in
        firestore.get(/databases/(default)/documents/kitchens/$(kitchenId)).data.memberIds;
    }
  }
}
